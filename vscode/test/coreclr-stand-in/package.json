  "engines": { "vscode": "^1.100.0" },
  "activationEvents": ["onDebug"],
  "main": "./extension.js",
  "contributes": {
    "debuggers": [{ "type": "coreclr", "label": "coreclr stand-in", "languages": ["csharp"] }]
  }
}
