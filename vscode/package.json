{
  "name": "runic-devkit",
  "displayName": "Runic DevKit",
  "description": "Runic SDK and Runic Translations in VS Code: dotnet runic dev, F5 of the Window, doctor, the ViewModel/Bridge tree, and MF2/RMF2 authoring through the project-local language server.",
  "version": "0.0.1",
  "preview": false,
  "publisher": "runic-artifex",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1f2427",
    "theme": "dark"
  },
  "license": "MIT",
  "homepage": "https://github.com/Runic-Artifex/runic-editors/tree/main/vscode#readme",
  "bugs": {
    "url": "https://github.com/Runic-Artifex/runic-editors/issues"
  },
  "qna": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/Runic-Artifex/runic-editors",
    "directory": "vscode"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Other"
  ],
  "keywords": [
    "runic",
    "runic sdk",
    "runic translations",
    "mf2",
    "messageformat",
    "messageformat 2",
    "rmf2",
    "i18n",
    "l10n",
    "translations",
    "localization",
    "xliff",
    "dotnet",
    "csharp",
    "lsp",
    "language server"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onLanguage:rmf2",
    "workspaceContains:**/*.csproj",
    "workspaceContains:**/runic.json",
    "onDebugResolve:runic",
    "onDebugDynamicConfigurations:runic",
    "onCommand:runicTranslations.restart",
    "onCommand:runicTranslations.showOutput",
    "onCommand:runicTranslations.preview",
    "onCommand:runicTranslations.previewSamples",
    "onCommand:runicTranslations.previewLocale",
    "onCommand:runicTranslations.previewRequestedLocale",
    "onCommand:runicTranslations.previewTimeZone",
    "onCommand:runicTranslations.renameInput",
    "onCommand:runicTranslations.renameSlot",
    "onCommand:runicTranslations.extractGroup",
    "onCommand:runicTranslations.inlineResource",
    "onCommand:runicTranslations.renameResource",
    "onCommand:runicTranslations.exportXliff",
    "onCommand:runicTranslations.importXliffDryRun",
    "onCommand:runicTranslations.overrideLibraryMessage",
    "onCommand:runicTranslations.showStatus",
    "onCommand:runicTranslations.importCatalog"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "The language server runs the workspace's local .NET tool."
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "rmf2",
        "aliases": [
          "Runic MF2",
          "RMF2"
        ],
        "extensions": [
          ".mf2",
          ".rmf2"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "**/runic.json",
        "url": "./dist/schemas/project-v1.schema.json"
      }
    ],
    "grammars": [
      {
        "language": "rmf2",
        "scopeName": "source.rmf2",
        "path": "./syntaxes/rmf2.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "runic.translations.restart",
        "title": "Restart Language Server",
        "category": "Runic"
      },
      {
        "command": "runic.translations.showOutput",
        "title": "Show Output",
        "category": "Runic"
      },
      {
        "command": "runic.translations.preview",
        "title": "Preview Message",
        "category": "Runic"
      },
      {
        "command": "runic.translations.previewSamples",
        "title": "Change Preview Samples",
        "category": "Runic"
      },
      {
        "command": "runic.translations.previewLocale",
        "title": "Change Preview Locale",
        "category": "Runic"
      },
      {
        "command": "runic.translations.previewRequestedLocale",
        "title": "Change Preview Regional Locale",
        "category": "Runic"
      },
      {
        "command": "runic.translations.previewTimeZone",
        "title": "Change Preview Time Zone",
        "category": "Runic"
      },
      {
        "command": "runic.translations.renameInput",
        "title": "Rename Input in Resource Sources",
        "category": "Runic"
      },
      {
        "command": "runic.translations.renameSlot",
        "title": "Rename Slot in Resource Sources",
        "category": "Runic"
      },
      {
        "command": "runic.translations.extractGroup",
        "title": "Extract Group to Directory",
        "category": "Runic"
      },
      {
        "command": "runic.translations.inlineResource",
        "title": "Inline Resource into Ancestor",
        "category": "Runic"
      },
      {
        "command": "runic.translations.renameResource",
        "title": "Rename Resource in Resource Sources",
        "category": "Runic"
      },
      {
        "command": "runic.translations.exportXliff",
        "title": "Export XLIFF",
        "category": "Runic"
      },
      {
        "command": "runic.translations.importXliffDryRun",
        "title": "Import XLIFF (dry run)",
        "category": "Runic"
      },
      {
        "command": "runic.translations.overrideLibraryMessage",
        "title": "Override Library Message…",
        "category": "Runic"
      },
      {
        "command": "runic.translations.showStatus",
        "title": "Show Translation Status",
        "category": "Runic"
      },
      {
        "command": "runic.translations.importCatalog",
        "title": "Import .resx or i18next Catalog",
        "category": "Runic"
      },
      {
        "command": "runic.dev.start",
        "title": "Start dotnet runic dev",
        "category": "Runic",
        "icon": "$(play)",
        "enablement": "runic.sdkProject"
      },
      {
        "command": "runic.dev.startNoWindow",
        "title": "Start dotnet runic dev --no-window (frontend only)",
        "category": "Runic",
        "icon": "$(play-circle)",
        "enablement": "runic.sdkProject"
      },
      {
        "command": "runic.dev.stop",
        "title": "Stop dotnet runic dev",
        "category": "Runic",
        "icon": "$(debug-stop)",
        "enablement": "runic.sdkProject"
      },
      {
        "command": "runic.dev.debugWindow",
        "title": "Debug the Window (F5 with dotnet runic dev --no-window)",
        "category": "Runic",
        "icon": "$(debug-alt)",
        "enablement": "runic.sdkProject"
      },
      {
        "command": "runic.dev.openBrowser",
        "title": "Open the Development Server",
        "category": "Runic",
        "icon": "$(globe)",
        "enablement": "runic.sdkProject"
      },
      {
        "command": "runic.dev.openSessionFile",
        "title": "Open the dev Session File",
        "category": "Runic",
        "enablement": "runic.sdkProject"
      },
      {
        "command": "runic.dev.actions",
        "title": "dotnet runic dev Actions…",
        "category": "Runic",
        "enablement": "runic.sdkProject"
      },
      {
        "command": "runic.doctor.run",
        "title": "Run dotnet runic doctor",
        "category": "Runic",
        "icon": "$(refresh)",
        "enablement": "runic.sdkProject"
      },
      {
        "command": "runic.dependencies.build",
        "title": "Build Frontend Dependencies (dotnet build)",
        "category": "Runic",
        "icon": "$(tools)",
        "enablement": "runic.sdkProject"
      },
      {
        "command": "runic.dependencies.install",
        "title": "Install Frontend Dependencies",
        "category": "Runic",
        "icon": "$(package)",
        "enablement": "runic.sdkProject"
      },
      {
        "command": "runic.dependencies.openPackage",
        "title": "Open package.json",
        "category": "Runic",
        "icon": "$(go-to-file)",
        "enablement": "runic.sdkProject"
      },
      {
        "command": "runic.dependencies.show",
        "title": "Show Frontend Dependencies",
        "category": "Runic",
        "enablement": "runic.sdkProject"
      },
      {
        "command": "runic.dependencies.run",
        "title": "Run Package Manager",
        "category": "Runic",
        "enablement": "runic.sdkProject"
      },
      {
        "command": "runic.viewModels.refresh",
        "title": "Refresh ViewModels",
        "category": "Runic",
        "icon": "$(refresh)",
        "enablement": "runic.sdkProject"
      },
      {
        "command": "runic.openSourceLocation",
        "title": "Open C# Member",
        "category": "Runic"
      },
      {
        "command": "runic.translations.refreshStatusView",
        "title": "Refresh Translation Status",
        "category": "Runic",
        "icon": "$(refresh)"
      },
      {
        "command": "runic.showOutput",
        "title": "Show Runic SDK Output",
        "category": "Runic",
        "enablement": "runic.sdkProject"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "runic",
          "title": "Runic",
          "icon": "media/runic-activity.svg"
        }
      ]
    },
    "views": {
      "runic": [
        {
          "id": "runic.devSession",
          "name": "Dev Session",
          "when": "runic.sdkProject"
        },
        {
          "id": "runic.viewModels",
          "name": "ViewModels",
          "when": "runic.sdkProject"
        },
        {
          "id": "runic.doctor",
          "name": "Doctor",
          "when": "runic.sdkProject"
        },
        {
          "id": "runic.translationsStatus",
          "name": "Translations",
          "when": "runic.translationsProject"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "runic.devSession",
        "contents": "dotnet runic dev runs the development server and the Window and restarts it after C# edits.\n[Start dotnet runic dev](command:runic.dev.start)\n[Debug the Window](command:runic.dev.debugWindow)"
      },
      {
        "view": "runic.viewModels",
        "contents": "No development source map yet. Build the project, or start dotnet runic dev, to list its ViewModels and Bridge members.\n[Start dotnet runic dev](command:runic.dev.start)"
      },
      {
        "view": "runic.doctor",
        "contents": "dotnet runic doctor checks this machine and the project: the .NET SDK, the JavaScript runtime, lock files, the Window host's runtime and more.\n[Run dotnet runic doctor](command:runic.doctor.run)"
      },
      {
        "view": "runic.translationsStatus",
        "contents": "No translation status yet. Restore the project's runic-translations tool (dotnet tool restore).\n[Show Translation Status](command:runic.translations.showStatus)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "runic.dev.start",
          "when": "view == runic.devSession && !runic.devActive",
          "group": "navigation@1"
        },
        {
          "command": "runic.dev.stop",
          "when": "view == runic.devSession && runic.devActive",
          "group": "navigation@1"
        },
        {
          "command": "runic.dev.debugWindow",
          "when": "view == runic.devSession",
          "group": "navigation@2"
        },
        {
          "command": "runic.dev.startNoWindow",
          "when": "view == runic.devSession && !runic.devActive",
          "group": "more@1"
        },
        {
          "command": "runic.dev.openBrowser",
          "when": "view == runic.devSession && runic.devActive",
          "group": "more@2"
        },
        {
          "command": "runic.dependencies.build",
          "when": "view == runic.devSession",
          "group": "more@3"
        },
        {
          "command": "runic.viewModels.refresh",
          "when": "view == runic.viewModels",
          "group": "navigation"
        },
        {
          "command": "runic.doctor.run",
          "when": "view == runic.doctor",
          "group": "navigation"
        },
        {
          "command": "runic.translations.refreshStatusView",
          "when": "view == runic.translationsStatus",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "runic.dev.start",
          "when": "view == runic.devSession && viewItem =~ /^runic(Project|Dev)\\.stopped$/",
          "group": "inline@1"
        },
        {
          "command": "runic.dev.stop",
          "when": "view == runic.devSession && viewItem =~ /^runic(Project|Dev)\\.active$/",
          "group": "inline@1"
        },
        {
          "command": "runic.dev.debugWindow",
          "when": "view == runic.devSession && viewItem =~ /^runic(Project|Dev)\\./",
          "group": "inline@2"
        },
        {
          "command": "runic.dependencies.build",
          "when": "view == runic.devSession && viewItem == runicDependencies",
          "group": "inline@1"
        },
        {
          "command": "runic.dependencies.openPackage",
          "when": "view == runic.devSession && viewItem =~ /^runicDependency\\./",
          "group": "inline@1"
        }
      ],
      "commandPalette": [
        {
          "command": "runic.openSourceLocation",
          "when": "false"
        },
        {
          "command": "runic.translations.refreshStatusView",
          "when": "false"
        },
        {
          "command": "runic.dependencies.openPackage",
          "when": "false"
        },
        {
          "command": "runic.dependencies.run",
          "when": "false"
        }
      ]
    },
    "taskDefinitions": [
      {
        "type": "runic",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "dev",
              "build",
              "doctor"
            ],
            "description": "dev: dotnet runic dev; build: dotnet build; doctor: dotnet runic doctor."
          },
          "noWindow": {
            "type": "boolean",
            "description": "dev only: dotnet runic dev --no-window, for a Window that the debugger starts."
          },
          "project": {
            "type": "string",
            "description": "The project file, relative to the workspace folder; needed when the folder has several Runic SDK projects."
          },
          "workspaceTask": {
            "type": "string",
            "description": "dev only: the label of the workspace task (the template's runic: dev) whose process DevKit runs in its own terminal."
          }
        }
      },
      {
        "type": "runic-tools",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "restore"
            ],
            "description": "restore: dotnet tool restore, which the Restore tools button runs."
          },
          "cwd": {
            "type": "string",
            "description": "The folder it runs in: the project's."
          }
        }
      },
      {
        "type": "runic-install",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "description": "The package manager command that a frontend dependency quick fix runs, such as bun install --ignore-scripts."
          },
          "cwd": {
            "type": "string",
            "description": "The folder it runs in."
          }
        }
      }
    ],
    "problemPatterns": [
      {
        "name": "runic-dev",
        "regexp": "^\\s*(?:\\[[A-Za-z][\\w-]*\\]\\s+)?(?:\\d+>)?(\\S(?:(?!:\\s).)*?)(?:\\((\\d+)(?:,(\\d+))?(?:,\\d+,\\d+)?\\))?\\s*:\\s+(?:[^\\s:]+\\s+)?(error|warning)\\s+([A-Za-z]+\\d+)\\s*:\\s*(.*?)(?:\\s+\\[[^\\]]+\\])?$",
        "file": 1,
        "line": 2,
        "column": 3,
        "severity": 4,
        "code": 5,
        "message": 6
      },
      {
        "name": "runic-dev-none",
        "regexp": "(?!)",
        "file": 1,
        "line": 2,
        "message": 3
      }
    ],
    "problemMatchers": [
      {
        "name": "runic-dev",
        "label": "dotnet runic dev",
        "owner": "runic",
        "source": "runic",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "pattern": "$runic-dev",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\[dev\\] (Evaluating|Window exited|Reloading)",
          "endsPattern": "^\\[dev\\] Ready$"
        }
      },
      {
        "name": "runic-dev-no-window",
        "label": "dotnet runic dev --no-window",
        "owner": "runic",
        "source": "runic",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "pattern": "$runic-dev",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\[dev\\] Evaluating",
          "endsPattern": "^\\[dev\\] Ready$"
        }
      },
      {
        "name": "runic-dev-terminal",
        "label": "dotnet runic dev (DevKit's terminal)",
        "owner": "runic",
        "source": "runic",
        "pattern": "$runic-dev-none",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\[dev\\] (Evaluating|Window exited|Reloading)",
          "endsPattern": "^\\[dev\\] Ready$"
        }
      },
      {
        "name": "runic-dev-terminal-no-window",
        "label": "dotnet runic dev --no-window (DevKit's terminal)",
        "owner": "runic",
        "source": "runic",
        "pattern": "$runic-dev-none",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\[dev\\] Evaluating",
          "endsPattern": "^\\[dev\\] Ready$"
        }
      }
    ],
    "debuggers": [
      {
        "type": "runic",
        "label": "Runic Window",
        "languages": [
          "csharp"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "project": {
                "type": "string",
                "description": "The Window's project file, relative to the workspace folder; optional with one Runic SDK project."
              },
              "launchProfile": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The \"Project\" profile of the project's Properties/launchSettings.json whose commandLineArgs, environmentVariables and workingDirectory the Window gets. No value: the first \"Project\" profile, as dotnet run chooses; null: none. DevKit applies it, so the C# debugger does not apply it again."
              },
              "launchSettingsProfile": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The C# debugger's name for launchProfile, read the same way; launchProfile wins when both are set."
              },
              "launchSettingsFilePath": {
                "type": "string",
                "description": "A launchSettings.json other than the project's Properties/launchSettings.json; relative to the workspace folder."
              },
              "args": {
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  {
                    "type": "string"
                  }
                ],
                "description": "More arguments for the Window, after the project's (StartArguments, as RunArguments) and the launch profile's commandLineArgs. An array is passed as it is; a string is split as .NET splits a command line. Arguments for Debug builds only belong in StartArguments in a Debug PropertyGroup."
              },
              "cwd": {
                "type": "string",
                "description": "The Window's working directory. Default: the launch profile's workingDirectory (relative to the project folder), else MSBuild's RunWorkingDirectory, else the project folder."
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "More environment variables for the Window, over the launch profile's and envFile's. The dev session's Runic variables are set last."
              },
              "envFile": {
                "type": "string",
                "description": "A .env file (NAME=value lines) of environment variables for the Window, over the launch profile's and under env. Relative to the workspace folder."
              },
              "devArgs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "More options for the dotnet runic dev --no-window that DevKit starts before the Window (not for a dev that already runs). Replaces the launch profile's rax.devArguments."
              },
              "console": {
                "enum": [
                  "internalConsole",
                  "integratedTerminal",
                  "externalTerminal"
                ],
                "default": "internalConsole",
                "description": "Where the Window's console output goes. Passed to the C# debugger unchanged (see the C# extension's coreclr launch options)."
              },
              "stopAtEntry": {
                "type": "boolean",
                "description": "Stop at the Window's entry point. Passed to the C# debugger unchanged (see the C# extension's coreclr launch options)."
              },
              "justMyCode": {
                "type": "boolean",
                "description": "Passed to the C# debugger unchanged (see the C# extension's coreclr launch options)."
              },
              "requireExactSource": {
                "type": "boolean",
                "description": "Passed to the C# debugger unchanged (see the C# extension's coreclr launch options)."
              },
              "enableStepFiltering": {
                "type": "boolean",
                "description": "Passed to the C# debugger unchanged (see the C# extension's coreclr launch options)."
              },
              "suppressJITOptimizations": {
                "type": "boolean",
                "description": "Passed to the C# debugger unchanged (see the C# extension's coreclr launch options)."
              },
              "symbolOptions": {
                "type": "object",
                "description": "Passed to the C# debugger unchanged (see the C# extension's coreclr launch options)."
              },
              "sourceFileMap": {
                "type": "object",
                "description": "Passed to the C# debugger unchanged (see the C# extension's coreclr launch options)."
              },
              "sourceLinkOptions": {
                "type": "object",
                "description": "Passed to the C# debugger unchanged (see the C# extension's coreclr launch options)."
              },
              "expressionEvaluationOptions": {
                "type": "object",
                "description": "Passed to the C# debugger unchanged (see the C# extension's coreclr launch options)."
              },
              "logging": {
                "type": "object",
                "description": "Passed to the C# debugger unchanged (see the C# extension's coreclr launch options)."
              },
              "pipeTransport": {
                "type": "object",
                "description": "Passed to the C# debugger unchanged (see the C# extension's coreclr launch options)."
              },
              "targetArchitecture": {
                "type": "string",
                "description": "Passed to the C# debugger unchanged (see the C# extension's coreclr launch options)."
              },
              "targetOutputLogPath": {
                "type": "string",
                "description": "Passed to the C# debugger unchanged (see the C# extension's coreclr launch options)."
              },
              "terminateChildProcesses": {
                "type": "boolean",
                "description": "Passed to the C# debugger unchanged (see the C# extension's coreclr launch options)."
              },
              "checkForDevCert": {
                "type": "boolean",
                "description": "Passed to the C# debugger unchanged (see the C# extension's coreclr launch options)."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "runic",
            "request": "launch",
            "name": "Runic: Window"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Runic: Window",
            "description": "Starts dotnet runic dev --no-window, builds, and debugs the Window with the C# extension.",
            "body": {
              "type": "runic",
              "request": "launch",
              "name": "Runic: Window"
            }
          }
        ]
      }
    ],
    "configuration": {
      "title": "Runic",
      "properties": {
        "runic.dotnetPath": {
          "type": "string",
          "default": "dotnet",
          "scope": "machine-overridable",
          "description": "The dotnet executable that runs the project-local Runic tools (dotnet runic, runic-translations). Replaces runicTranslations.dotnetPath."
        },
        "runic.translations.serverAssembly": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Optional compiled Runic Translations tool DLL, relative to the workspace. Empty uses dotnet tool run runic-translations. Replaces runicTranslations.serverAssembly."
        },
        "runic.translations.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication with the Runic language server in its output. Replaces runicTranslations.trace.server."
        },
        "runicTranslations.dotnetPath": {
          "type": "string",
          "default": "dotnet",
          "scope": "machine-overridable",
          "markdownDeprecationMessage": "Use `#runic.dotnetPath#`. This setting still applies while that one is not set.",
          "description": "Former setting of the Translations extension; use runic.dotnetPath."
        },
        "runicTranslations.serverAssembly": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDeprecationMessage": "Use `#runic.translations.serverAssembly#`. This setting still applies while that one is not set.",
          "description": "Former setting of the Translations extension; use runic.translations.serverAssembly."
        },
        "runicTranslations.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "markdownDeprecationMessage": "Use `#runic.translations.trace.server#`. This setting still applies while that one is not set.",
          "description": "Former setting of the Translations extension; use runic.translations.trace.server."
        }
      }
    }
  },
  "scripts": {
    "build": "bun build src/extension.ts --target=node --format=cjs --external=vscode --outfile=dist/extension.cjs && node package-assets.mjs",
    "check": "tsc --noEmit",
    "test": "bun test test/unit.test.ts test/sdk.test.ts test/launch.test.ts test/protocol.test.ts test/dependencies.test.ts",
    "test:host": "node test/run-host.mjs",
    "test:host:protocol2": "RUNIC_TRANSLATIONS_PROTOCOL=2 node test/run-host.mjs",
    "package": "bun run build && node package.mjs"
  },
  "dependencies": {
    "vscode-languageclient": "10.1.2"
  },
  "devDependencies": {
    "@types/vscode": "1.100.0",
    "@types/node": "24.19.1",
    "typescript": "6.0.3",
    "@vscode/vsce": "4.1.1"
  },
  "packageManager": "bun@1.4.4"
}
