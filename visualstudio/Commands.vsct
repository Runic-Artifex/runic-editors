<?xml version="1.0" encoding="utf-8"?>
<!--
  The whole Runic DevKit command table (PARITY §3, §7.2 VS-1). Later slices add handlers in their own files
  (each derives from RunicCommandHandler) and do not edit this file; Core/RunicCommands.cs holds the same IDs, and
  Core.Tests/CommandTableTests.cs checks this file, the catalog and the handlers against each other.
  Commands whose handler is still a stub are DefaultInvisible and stay hidden.
-->
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable">
  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />
  <Include href="KnownImageIds.vsct" />
  <Commands package="guidRunicPackage">
