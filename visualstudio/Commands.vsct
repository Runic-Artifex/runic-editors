      <Menu guid="guidRunicCommands" id="RunicToolsMenu" priority="0x0100" type="Menu">
        <Parent guid="guidRunicCommands" id="ToolsMenuGroup" />
        <Strings><ButtonText>Runic</ButtonText><CommandName>Runic</CommandName></Strings>
      </Menu>
      <Menu guid="guidRunicCommands" id="ToolWindowToolbar" type="ToolWindowToolbar">
        <CommandFlag>DefaultDocked</CommandFlag>
        <Strings><ButtonText>Runic</ButtonText><CommandName>Runic Toolbar</CommandName></Strings>
