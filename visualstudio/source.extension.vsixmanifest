<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011">
  <Metadata>
    <Identity Id="RunicArtifex.DevKit.VisualStudio" Version="|%CurrentProject%;GetRunicVsixVersion|" Language="en-US" Publisher="Runic Artifex" />
    <DisplayName>Runic DevKit</DisplayName>
    <Description xml:space="preserve">Runic DevKit for Visual Studio: the Runic SDK and Runic Translations extension. The dotnet runic dev session, Debug the Window, doctor and the ViewModels tree; MF2 and RMF2 diagnostics, navigation and refactorings. Replaces Runic MF2 Translations; uninstall that one.</Description>
    <MoreInfo>https://github.com/Runic-Artifex/runic-editors/blob/main/visualstudio/README.md</MoreInfo>
    <License>LICENSE.txt</License>
    <ReleaseNotes>https://github.com/Runic-Artifex/runic-editors/releases</ReleaseNotes>
    <Icon>media\icon.png</Icon>
    <PreviewImage>media\preview.png</PreviewImage>
    <Tags>runic;mf2;messageformat;rmf2;i18n;l10n;translations;localization;xliff;csharp;lsp</Tags>
  </Metadata>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[18.0,19.0)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
  </Installation>
  <Dependencies />
  <Assets>
    <Asset Type="Microsoft.VisualStudio.MefComponent" Path="RunicArtifex.DevKit.VisualStudio.dll" />
    <Asset Type="Microsoft.VisualStudio.VsPackage" Path="Runic.pkgdef" />
    <Asset Type="Microsoft.VisualStudio.VsPackage" Path="RunicArtifex.DevKit.VisualStudio.pkgdef" />
  </Assets>
  <Prerequisites>
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" Version="[18.0,19.0)" DisplayName="Visual Studio core editor" />
  </Prerequisites>
</PackageManifest>
