<Project Sdk="Microsoft.NET.Sdk">
  <!-- A client library as the VS Code host test sees it (runic-sdk's examples/shared-library-clients): a Runic SDK
       project that is not a Window project, so it is no dev target. It is never built. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RunicApplicationFrontendClientLibrary>true</RunicApplicationFrontendClientLibrary>
    <RunicApplicationFrontendDirectory>$(MSBuildProjectDirectory)/../shared-ui</RunicApplicationFrontendDirectory>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Runic.Application.Views" Version="0.24.0" />
  </ItemGroup>
</Project>
